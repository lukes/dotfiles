{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "update": "auto",
  "enabled_providers": [],
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git show*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git branch*",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "grep *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "cat *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "head *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "tail *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "wc *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "ls *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "find *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "echo *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "which *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pwd",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "date",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "od *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "printf *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git commit*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git push*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "rm -rf *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "curl *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "wget *",
      "effect": "deny"
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "allow"
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "*_list",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_list_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_view",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_get",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_get_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_diff",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_status",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_trace",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_search*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_orbit_*",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "glab_glab_version",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "*_api",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "*_securefile_*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "*token*",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "browser",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.aws/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.aws/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.aws/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.config/opencode/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.config/opencode/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.config/opencode/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.gnupg/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.gnupg/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.gnupg/*",
      "effect": "deny"
    },
    {
      "action": "external_directory",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.ssh/*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.netrc",
      "effect": "deny"
    },
    {
      "action": "edit",
      "resource": "~/.netrc",
      "effect": "deny"
    }
  ],
  "plugins": []
}
